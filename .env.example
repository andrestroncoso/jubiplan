# ====================================
# CONFIGURACIÓN DE SEGURIDAD
# ====================================

# Puerto del servidor
PORT=3000

# Ambiente (development, production, test)
NODE_ENV=production

# CORS - Dominios permitidos (separados por coma)
# Desarrollo: http://localhost:3000,http://localhost:5173
# Producción: https://midominio.com,https://www.midominio.com
ALLOWED_ORIGINS=http://localhost:3000

# ====================================
# INFORMACIÓN DE CLIENTE
# ====================================

# Base URL del Frontend
REACT_APP_API_BASE=http://localhost:3000

# ====================================
# LOGGING Y MONITOREO
# ====================================

# Nivel de log (error, warn, info, debug)
LOG_LEVEL=info

# ====================================
# DATOS Y ACTUALIZACIÓN
# ====================================

# Intervalo de actualización de datos (milisegundos)
UPDATE_INTERVAL=86400000
